# Supabase: dashboard > Connect > Direct > "Session pooler" (port 5432).
# Replace <project-ref>, <YOUR-PASSWORD> and <host>. URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@<host>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Local development only (prisma migrate dev). Not needed for prisma migrate deploy or production.
# SHADOW_DATABASE_URL=""

# Use two different long random strings:
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
PORT=3000

# ---- Password-reset emails ----
# Address users' browsers can reach this API at. It is put in the reset link inside the email.
# Local test on your Wi-Fi: http://<your-PC-IP>:3000   Production: https://api.yourcompany.com (HTTPS required)
PUBLIC_API_URL="http://localhost:3000"
APP_NAME="Subscription Tracker"

# SMTP provider. If SMTP_HOST is empty, reset links are only logged to the console.
# Examples:  Resend:   smtp.resend.com  465  user=resend         pass=<API key>
#            SendGrid: smtp.sendgrid.net 587 user=apikey         pass=<API key>
#            Gmail (testing only, needs an app password): smtp.gmail.com 465 user=<you@gmail.com>
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# The sender must be on a domain you have verified with your provider (SPF/DKIM) for reliable delivery.
EMAIL_FROM="Subscription Tracker <no-reply@yourcompany.com>"

REVENUECAT_WEBHOOK_AUTH=""
REVENUECAT_SECRET_KEY=""
REVENUECAT_ENTITLEMENT_ID=""
# Resend (used instead of SMTP when set)
RESEND_API_KEY=