{
  "expo": {
    "name": "Subscription Tracker",
    "slug": "subscription-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "subscription-tracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f8f6f1",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kolhsys.subscriptiontracker"
    },
    "android": {
      "package": "com.kolhsys.subscriptiontracker",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
   "plugins": [
     "expo-router",
     [
       "expo-notifications",
       {
         "icon": "./assets/images/notification-icon.png",
         "color": "#F0C274",
         "defaultChannel": "renewal-reminders"
       }
     ]
   ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fa0f660-c655-4847-87c4-347e426c8a55"
      }
    },
    "owner": "kolhsys"
  }
}
