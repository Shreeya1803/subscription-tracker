{
  "expo": {
    "name": "Subscription Tracker",
    "slug": "subscription-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "subscription-tracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kolhsys.subscriptiontracker"
    },
    "android": {
      "package": "com.kolhsys.subscriptiontracker",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#04153B"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#04153B",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#04153B"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F0C274",
          "defaultChannel": "renewal-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fa0f660-c655-4847-87c4-347e426c8a55"
      }
    },
    "owner": "kolhsys"
  }
}
