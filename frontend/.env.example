# Android emulator:  http://10.0.2.2:3000
# iOS simulator:     http://localhost:3000
# Physical phone:    http://<your-PC-LAN-IP>:3000  (same Wi-Fi, firewall open)
EXPO_PUBLIC_API_URL=http://<your-PC-LAN-IP>:3000
#http://192.168.1.10:3000
# RevenueCat public keys. Test key for development only: remove it for store builds.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Supabase project (Project Settings -> API Keys). The publishable key is meant to ship in the app.
# NEVER put the secret / service_role key in any EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# RevenueCat Test Store key: used only in development builds (Expo Go / dev client).
EXPO_PUBLIC_REVENUECAT_TEST_KEY=